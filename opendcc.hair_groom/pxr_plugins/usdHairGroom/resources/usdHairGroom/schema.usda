#usda 1.0
(
    """ schemata for HairGroom nodes """
    subLayers = [ @usd/schema.usda@ ]
)

over "GLOBAL" (
    customData = {
        string libraryName       = "usdHydraOpGroom"
        string libraryPath       = "."
        string libraryPrefix     = "UsdHydraOpGroom"
    }
) {}

class HydraOpGroomGuide "HydraOpGroomGuide" (
    doc = "Generates guide curves distributed on a scalp mesh"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Guide"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    rel inputs:scalpMesh
    int hair:guideCount = 500
    float hair:guideLength = 0.15
    int hair:seed = 0
    bool hair:preview = 0
    token outputs:out
}

class HydraOpGroomScatter "HydraOpGroomScatter" (
    doc = "Interpolates dense child hairs from sparse guides"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Scatter"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    float hair:scatter:density = 5000
    int hair:scatter:maxInfluences = 4
    int hair:seed = 0
    bool hair:preview = 0
    token outputs:out
}

class HydraOpGroomClump "HydraOpGroomClump" (
    doc = "Attracts hairs toward clump centers"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Clump"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    int hair:clump:count = 50
    float hair:clump:intensity = 0.8
    float hair:clump:radius = 0.05
    float hair:clump:rampStart = 0.0
    float hair:clump:rampEnd = 1.0
    int hair:clump:seed = 0
    bool hair:preview = 0
    token outputs:out
}

class HydraOpGroomCurl "HydraOpGroomCurl" (
    doc = "Applies a helical curl along hair length"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Curl"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    float hair:curl:frequency = 8.0
    float hair:curl:amplitude = 0.01
    float hair:curl:rampStart = 0.0
    float hair:curl:rampEnd = 1.0
    int hair:curl:seed = 0
    bool hair:preview = 0
    token outputs:out
}

class HydraOpGroomNoise "HydraOpGroomNoise" (
    doc = "Adds smooth per-point noise to hair"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Noise"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    float hair:noise:frequency = 4.0
    float hair:noise:amplitude = 0.005
    float hair:noise:rampStart = 0.0
    float hair:noise:rampEnd = 1.0
    int hair:noise:seed = 0
    bool hair:preview = 0
    token outputs:out
}

class HydraOpGroomOutput "HydraOpGroomOutput" (
    doc = "Terminal output node for a grooming graph"
    inherits = </HydraOpBaseNode>
    customData = {
        string className = "Output"
        dictionary extraPlugInfo = {
            bool providesUsdShadeConnectableAPIBehavior = 1
        }
    }
)
{
    bool inputs:bypass = 0
    token inputs:in
    bool hair:preview = 0
    token outputs:out
}
